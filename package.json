{
  "name": "scraper-challenge",
  "version": "1.0.0",
  "description": "Scraper TypeScript (HTTP puro) para Jurisprudencia PJ — desafío técnico de scraping",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "scrape": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "scraper",
    "typescript",
    "jsf",
    "cheerio"
  ],
  "author": "Bruno Mont",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/brunomont/scraper-challenge.git"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.2.0",
    "commander": "^14.0.2",
    "domhandler": "^6.0.1",
    "p-limit": "^7.2.0"
  }
}
